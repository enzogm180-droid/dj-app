{
  "name": "dj-app",
  "productName": "Stemzo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "electron . --dev",
    "app:instalador": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "soundtouchjs": "^0.1.30"
  },
  "description": "Stemzo: programa de DJ con stems",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.stemzo.app",
    "productName": "Stemzo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stemzo"
    }
  },
  "author": "Enzo"
}
